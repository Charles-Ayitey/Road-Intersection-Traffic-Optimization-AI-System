<configuration>
    <input>
        <net-file value="junction.net.xml"/>
        <route-files value="junction.rou.xml"/>
        <additional-files value="junction.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <ignore-junction-blocker value="1"/>
        <time-to-teleport value="-1"/>
        <max-depart-delay value="600"/>
    </processing>
</configuration>