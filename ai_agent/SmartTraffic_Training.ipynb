   "source": [
    "# Smart Traffic System: RL Training on Google Colab
",
    "
",
    "This notebook is designed to run in Google Colab (either via browser or connected through VS Code). It handles the SUMO installation and trains the PPO agent."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install SUMO and dependencies
",
    "!sudo add-apt-repository ppa:sumo/stable -y
",
    "!sudo apt-get update
",
    "!sudo apt-get install sumo sumo-tools sumo-doc
",
    "
",
    "# Set SUMO_HOME environment variable
",
    "import os
",
    "os.environ['SUMO_HOME'] = "/usr/share/sumo"
",
    "
",
    "# Install Python libraries
",
    "!pip install stable-baselines3[extra] gymnasium"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Mount Google Drive (Optional)
",
    "If you want to save models directly to your Drive, run the cell below. Otherwise, files will stay in the local Colab session."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive
",
    "drive.mount('/content/drive')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Training Script
",
    "This cell will load your `SumoTrafficEnv` and start training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys
",
    "import os
",
    "from stable_baselines3 import PPO
",
    "
",
    "# Assuming your project files are in the current directory or mounted Drive
",
    "# If you are using VS Code connected to Colab, your local files should be accessible.
",
    "from ai_agent.sumo_env import SumoTrafficEnv
",
    "
",
    "def train():
",
    "    # Path to your .sumocfg file
",
    "    config_path = "simulation/junction.sumocfg"
",
    "    
",
    "    # Initialize environment (no GUI for Colab)
",
    "    env = SumoTrafficEnv(config_path, use_gui=False)
",
    "    
",
    "    # Define PPO Model
",
    "    model = PPO(
",
    "        "MlpPolicy", 
",
    "        env, 
",
    "        verbose=1, 
",
    "        learning_rate=0.0003,
",
    "        n_steps=2048,
",
    "        batch_size=64,
",
    "        tensorboard_log="./data/ppo_traffic_tensorboard/"
",
    "    )
",
    "    
",
    "    print("Starting training for 100,000 steps...")
",
    "    model.learn(total_timesteps=100000)
",
    "    
",
    "    # Save Model
",
    "    os.makedirs("models", exist_ok=True)
",
    "    model.save("models/ppo_traffic_agent_refined")
",
    "    print("Training complete. Model saved.")
",
    "    
",
    "    env.close()
",
    "
",
    "if __name__ == "__main__":
",
    "    train()"
   ]
  }
 ],
